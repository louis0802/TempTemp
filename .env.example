# Real database results by default. Set true only for explicit synthetic testing.
DEMO_MODE=false
DATABASE_URL=
ADMIN_DATABASE_URL=
INGEST_DATABASE_URL=
MIGRATION_DATABASE_URL=
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ONEMAP_TOKEN=
# Configurable collection/review policy, in days.
BACKFILL_DAYS=30
UNKNOWN_EXPIRY_REVIEW_DAYS=7
# Explicit approved local JSON export. No Telegram scraping is enabled.
APPROVED_IMPORT_FILE=
# auto = MapTiler when keyed, otherwise keyless OSM. schematic = offline preview.
NEXT_PUBLIC_MAP_MODE=auto
# Bound all preview history and active-post refresh requests per source per run.
PREVIEW_MAX_PAGES=60
# Optional server-only Places API (New) key; never expose through NEXT_PUBLIC_.
# Strict path: branch enrichment; MVP path: observed merchant locations.
GOOGLE_PLACES_API_KEY=

# Use mvp for the home page; /mvp is always available. Strict APIs stay separate.
PROMOTION_DATA_SOURCE=strict
# Optional alternate artifact path for MVP serving.
MVP_DATA_PATH=data/mvp-promotions.json
# Reproducible corpus evaluation timestamp; live serving always uses current SG date.
MVP_AS_OF=2026-09-21T00:00:00+08:00
